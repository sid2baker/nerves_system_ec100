# Build the RK3506 kernel as a small, deterministic Nerves kernel.
# The vendor rk3506_defconfig enables WERROR and many optional modules intended
# for evaluation images; neither is useful for Nerves bring-up.
# CONFIG_WERROR is not set
# CONFIG_MODULES is not set

# EC100 / RK3506J essentials
CONFIG_SMP=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_AEABI=y
CONFIG_HIGHMEM=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_EXT4_FS=y

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_EARLY_PRINTK=y
# Use the standard UART0 console, not the vendor FIQ wrapper.
# CONFIG_FIQ_DEBUGGER is not set

# Original EC100 CPU supply/OPP/PVTM path. Keep 1200 MHz as the initial
# comparison; select a lower supported OPP separately during hardware testing.
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_ROCKCHIP_CPUFREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_REGULATOR_PWM=y
CONFIG_ROCKCHIP_OPP=y
CONFIG_ROCKCHIP_SYSTEM_MONITOR=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_ROCKCHIP_THERMAL=y

CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_ROCKCHIP=y

CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_SYSFS=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y

CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK3506=y

CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_DW_WATCHDOG=y

CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_MDIO_BUS=y
CONFIG_PHYLIB=y
CONFIG_MOTORCOMM_PHY=y

CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_STORAGE=y

CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_SPI=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_CAN=y
CONFIG_CAN_DEV=y
CONFIG_CAN_ROCKCHIP=y

CONFIG_CRYPTO=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ROCKCHIP=y

# Useful for Nerves Heart post-mortem breadcrumbs.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y

# Rockchip/RK3506 platform essentials used by the SoC DTS.
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARM_PSCI=y
CONFIG_CPU_RK3506=y
CONFIG_ROCKCHIP_CPUINFO=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y

# EC100 is headless; avoid unrelated DRM/GPU stacks and vendor-tree API mismatches.
# CONFIG_DRM is not set
# CONFIG_DRM_V3D is not set
# CONFIG_DRM_VC4 is not set
# CONFIG_DRM_ROCKCHIP is not set
